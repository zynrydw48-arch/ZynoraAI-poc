/* NYXUS AI rebrand: luxury light theme -- keeps V2 Sprint 1's white/cream
   neutrals (still fits the brand) but replaces every navy-blue accent
   (#2F4C74/#3E6089) with the brand's gold (#D4AF37 base for filled
   elements, #B8860B darker amber for borders/hover states that need
   contrast directly against a white background). Layered on top of the
   app's QPalette (see memoryos/theme.py) -- QSS here adds shape, spacing,
   and hover-state polish; any widget without an explicit rule below falls
   back to the palette's colors. */

QMainWindow, QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* QLabels never want their own opaque background box -- their color always
   comes from whatever container they sit in (sectionPanel, resultCard,
   emptyState, ...); without this every label nested in a styled panel paints
   a mismatched rectangle instead of blending into the panel. */
QLabel {
    background-color: transparent;
}

QLabel#sectionTitle {
    font-size: 17px;
    font-weight: 700;
    color: #0F172A;
    padding-bottom: 2px;
}

QLabel#mutedLabel {
    color: #64748B;
    font-size: 12px;
}

QLabel#statusLabelWarning {
    color: #9A5B1E;
    font-size: 12px;
    font-weight: 600;
}

QLabel#statusLabelError {
    color: #8C3540;
    font-size: 12px;
    font-weight: 600;
}

QWidget#sectionPanel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QLabel#toastBanner {
    background-color: #E4F0EA;
    color: #1F6F54;
    border: 1px solid #B9D9C8;
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 600;
}

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #D4AF37;
}

QLineEdit:focus {
    border: 1px solid #B8860B;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 18px;
}

QPushButton:hover {
    background-color: #EEF2F7;
    border: 1px solid #B8860B;
}

QPushButton:pressed {
    background-color: #E1E8F0;
}

QPushButton:disabled {
    color: #B0B8C2;
    background-color: #F8FAFC;
    border: 1px solid #E9EDF2;
}

QPushButton#primaryButton {
    background-color: #D4AF37;
    color: #0B132B;
    border: 1px solid #D4AF37;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #B8860B;
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#iconButton:hover {
    background-color: #E8EAF2;
}

QPushButton#dangerIconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#dangerIconButton:hover {
    background-color: #F5E1DF;
}

QWidget#resultCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QWidget#resultCard:hover {
    border: 1px solid #B8860B;
}

QWidget#emptyState {
    background-color: transparent;
}

/* V2: search results filter bar -- tokens reused exactly from sectionPanel/
   resultCard (surface/border/radius), mutedLabel (default tab text),
   QPushButton:hover (hover background), and the primary accent (checked
   tab's gold underline) -- no new colors introduced. */
QWidget#filterBar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QPushButton#filterTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 8px;
    padding: 8px 16px;
    color: #64748B;
}

QPushButton#filterTab:hover {
    background-color: #EEF2F7;
}

QPushButton#filterTab:checked {
    color: #0F172A;
    border-bottom: 2px solid #D4AF37;
}

/* AI Project Collections (Week 2, Phase 2): the filter bar's collection
   dropdown -- QComboBox had no rule at all before this, so it fell back to
   Fusion's flat gray default, clashing with the rest of the gold/navy
   theme. Tokens reused exactly from QLineEdit/QPushButton (surface/border/
   radius/hover) and QMenu (dropdown list). */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 12px;
    color: #0F172A;
}

QComboBox:hover {
    border: 1px solid #B8860B;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    color: #0F172A;
    selection-background-color: #E8EAF2;
    outline: none;
}

/* AI Project Collections (Week 2, Phase 2): the "📁 Name" chip ResultCard
   shows per collection a file belongs to -- a pale gold-tinted pill so it
   reads as a brand-accented tag rather than plain body text. */
QLabel#collectionBadge {
    background-color: #FDF3D9;
    color: #B8860B;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* One-Click Context Summary: the expandable bullet section below a card's
   action row -- a left gold accent border marks it as generated content,
   distinct from plain mutedLabel metadata text elsewhere on the card. */
QLabel#summaryLabel {
    background-color: #FBF8F1;
    color: #0F172A;
    border-left: 2px solid #D4AF37;
    border-radius: 4px;
    padding: 8px 10px;
    font-size: 12px;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #E2E8F0;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #D4AF37;
    border-radius: 6px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMenuBar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QMenuBar::item:selected {
    background-color: #E8EAF2;
    border-radius: 4px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E8EAF2;
}

QListWidget {
    border: none;
    background-color: transparent;
}

QListWidget::item {
    border-radius: 6px;
    padding: 4px 6px;
}

QListWidget::item:hover {
    background-color: #E8EAF2;
}

QListWidget::item:selected {
    background-color: #E8EAF2;
    color: #0F172A;
}
