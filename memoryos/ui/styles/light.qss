/* Luxury Visual & Motion Polish (Week 2 final phase): Premium Warm
   Alabaster window (#FAF7F2) with soft-champagne "glass" surfaces --
   panels/cards/inputs use a translucent rgba(255,253,249,0.82) fill over
   the solid alabaster window rather than a flat opaque white, faking a
   frosted-glass edge (QSS has no real backdrop-blur) without an actual blur
   pass. Borders default to an ultra-thin, low-alpha champagne hairline;
   :hover/:focus states firm up to a solid gold/amber border. Text moves
   from Sprint 1's cooler navy-gray to a richer titanium-charcoal. Layered
   on top of the app's QPalette (see memoryos/theme.py); QSS here adds
   shape, translucency, and hover-state polish -- any widget without an
   explicit rule below falls back to the palette's colors. */

QMainWindow, QWidget {
    background-color: #FAF7F2;
    color: #2B2B2E;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* QLabels never want their own opaque background box -- their color always
   comes from whatever container they sit in (sectionPanel, resultCard,
   emptyState, ...); without this every label nested in a styled panel paints
   a mismatched rectangle instead of blending into the panel. */
QLabel {
    background-color: transparent;
}

QLabel#sectionTitle {
    font-size: 17px;
    font-weight: 700;
    color: #2B2B2E;
    padding-bottom: 2px;
}

QLabel#mutedLabel {
    color: #6B6B70;
    font-size: 12px;
}

QLabel#statusLabelWarning {
    color: #9A5B1E;
    font-size: 12px;
    font-weight: 600;
}

QLabel#statusLabelError {
    color: #8C3540;
    font-size: 12px;
    font-weight: 600;
}

QWidget#sectionPanel {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
}

QLabel#toastBanner {
    background-color: #E4F0EA;
    color: #1F6F54;
    border: 1px solid #B9D9C8;
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 600;
}

QLineEdit {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 10px;
    padding: 10px 14px;
    color: #2B2B2E;
    selection-background-color: #D4AF37;
}

QLineEdit:focus {
    border: 1px solid #B8860B;
}

QPushButton {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 10px;
    padding: 9px 20px;
    color: #2B2B2E;
}

QPushButton:hover {
    background-color: #F3EEE4;
    border: 1px solid #B8860B;
}

QPushButton:pressed {
    background-color: #E9E2D3;
}

QPushButton:disabled {
    color: #B0B8C2;
    background-color: #FAF7F2;
    border: 1px solid rgba(212, 175, 55, 0.1);
}

QPushButton#primaryButton {
    background-color: #D4AF37;
    color: #2B2B2E;
    border: 1px solid #D4AF37;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #B8860B;
    color: #FAF7F2;
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#iconButton:hover {
    background-color: #F3EEE4;
}

QPushButton#dangerIconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#dangerIconButton:hover {
    background-color: #F5E1DF;
}

QWidget#resultCard {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
}

QWidget#resultCard:hover {
    border: 1px solid #B8860B;
}

QWidget#emptyState {
    background-color: transparent;
}

/* V2: search results filter bar -- tokens reused exactly from sectionPanel/
   resultCard (surface/border/radius), mutedLabel (default tab text),
   QPushButton:hover (hover background), and the primary accent (checked
   tab's gold underline) -- no new colors introduced. */
QWidget#filterBar {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 16px;
}

QPushButton#filterTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 8px;
    padding: 8px 16px;
    color: #6B6B70;
}

QPushButton#filterTab:hover {
    background-color: #F3EEE4;
}

QPushButton#filterTab:checked {
    color: #2B2B2E;
    border-bottom: 2px solid #D4AF37;
}

/* AI Project Collections (Week 2, Phase 2): the filter bar's collection
   dropdown -- QComboBox had no rule at all before this, so it fell back to
   Fusion's flat gray default, clashing with the rest of the gold/navy
   theme. Tokens reused exactly from QLineEdit/QPushButton (surface/border/
   radius/hover) and QMenu (dropdown list). */
QComboBox {
    background-color: rgba(255, 253, 249, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 10px;
    padding: 6px 12px;
    color: #2B2B2E;
}

QComboBox:hover {
    border: 1px solid #B8860B;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(212, 175, 55, 0.25);
    color: #2B2B2E;
    selection-background-color: #F3EEE4;
    outline: none;
}

/* AI Project Collections (Week 2, Phase 2): the "📁 Name" chip ResultCard
   shows per collection a file belongs to -- a pale gold-tinted pill so it
   reads as a brand-accented tag rather than plain body text. */
QLabel#collectionBadge {
    background-color: #FDF3D9;
    color: #B8860B;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* One-Click Context Summary: the expandable bullet section below a card's
   action row -- a left gold accent border marks it as generated content,
   distinct from plain mutedLabel metadata text elsewhere on the card. */
QLabel#summaryLabel {
    background-color: #F3EEE4;
    color: #2B2B2E;
    border-left: 2px solid #D4AF37;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 12px;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #F3EEE4;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #D4AF37;
    border-radius: 6px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #E3DCCB;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #D0C6AC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMenuBar {
    background-color: #FAF7F2;
    border-bottom: 1px solid rgba(212, 175, 55, 0.25);
}

QMenuBar::item:selected {
    background-color: #F3EEE4;
    border-radius: 4px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #F3EEE4;
}

QListWidget {
    border: none;
    background-color: transparent;
}

QListWidget::item {
    border-radius: 6px;
    padding: 4px 6px;
}

QListWidget::item:hover {
    background-color: #F3EEE4;
}

QListWidget::item:selected {
    background-color: #F3EEE4;
    color: #2B2B2E;
}
