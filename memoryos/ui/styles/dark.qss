/* NYXUS AI rebrand: luxury dark theme -- deep navy backgrounds/surfaces
   (#0B0F17/#0B132B) with a gold brand accent (#D4AF37/#E5C158) replacing
   V2 Sprint 1's muted slate/navy scheme. Layered on top of the app's dark
   QPalette (see memoryos/theme.py) -- QSS here adds shape, spacing, and
   hover-state polish; any widget without an explicit rule below falls
   back to the palette's colors. */

QMainWindow, QWidget {
    background-color: #0B0F17;
    color: #F2EFE9;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* QLabels never want their own opaque background box -- their color always
   comes from whatever container they sit in (sectionPanel, resultCard,
   emptyState, ...); without this every label nested in a styled panel paints
   a mismatched rectangle instead of blending into the panel. */
QLabel {
    background-color: transparent;
}

QLabel#sectionTitle {
    font-size: 17px;
    font-weight: 700;
    color: #F2EFE9;
    padding-bottom: 2px;
}

QLabel#mutedLabel {
    color: #8B93A8;
    font-size: 12px;
}

QLabel#statusLabelWarning {
    color: #C9812E;
    font-size: 12px;
    font-weight: 600;
}

QLabel#statusLabelError {
    color: #C97781;
    font-size: 12px;
    font-weight: 600;
}

QWidget#sectionPanel {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 14px;
}

QLabel#toastBanner {
    background-color: #1B3A2E;
    color: #6FBF9B;
    border: 1px solid #2E5A46;
    border-radius: 10px;
    padding: 8px 12px;
    font-weight: 600;
}

QLineEdit {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 8px;
    padding: 8px 12px;
    color: #F2EFE9;
    selection-background-color: #D4AF37;
}

QLineEdit:focus {
    border: 1px solid #E5C158;
}

QPushButton {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 8px;
    padding: 8px 18px;
    color: #F2EFE9;
}

QPushButton:hover {
    background-color: #16213A;
    border: 1px solid #E5C158;
}

QPushButton:pressed {
    background-color: #080D1C;
}

QPushButton:disabled {
    color: #5F6B85;
    background-color: #080B14;
    border: 1px solid #14192B;
}

QPushButton#primaryButton {
    background-color: #D4AF37;
    color: #0B132B;
    border: 1px solid #D4AF37;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #E5C158;
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#iconButton:hover {
    background-color: #1C2541;
}

QPushButton#dangerIconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#dangerIconButton:hover {
    background-color: #4C262B;
}

QWidget#resultCard {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 14px;
}

QWidget#resultCard:hover {
    border: 1px solid #E5C158;
}

QWidget#emptyState {
    background-color: transparent;
}

/* V2: search results filter bar -- tokens reused exactly from sectionPanel/
   resultCard (surface/border/radius), mutedLabel (default tab text),
   QPushButton:hover (hover background), and the primary accent (checked
   tab's gold underline) -- no new colors introduced. */
QWidget#filterBar {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 14px;
}

QPushButton#filterTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 8px;
    padding: 8px 16px;
    color: #8B93A8;
}

QPushButton#filterTab:hover {
    background-color: #16213A;
}

QPushButton#filterTab:checked {
    color: #F2EFE9;
    border-bottom: 2px solid #D4AF37;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #1C2541;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #D4AF37;
    border-radius: 6px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #1C2541;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #2A3A5C;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMenuBar {
    background-color: #0B0F17;
    border-bottom: 1px solid #1C2541;
}

QMenuBar::item:selected {
    background-color: #1C2541;
    border-radius: 4px;
}

QMenu {
    background-color: #0B132B;
    border: 1px solid #1C2541;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 22px;
    border-radius: 4px;
    color: #F2EFE9;
}

QMenu::item:selected {
    background-color: #1C2541;
}

QListWidget {
    border: none;
    background-color: transparent;
}

QListWidget::item {
    border-radius: 6px;
    padding: 4px 6px;
}

QListWidget::item:hover {
    background-color: #1C2541;
}

QListWidget::item:selected {
    background-color: #1C2541;
    color: #F2EFE9;
}
